# ====================================================================
# Mule Application .gitignore
# For CE-MULE-4-Platform-Backend-Mule repository
# ====================================================================

# ====================================================================
# Maven Build Output
# ====================================================================

# Maven target directory
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# ====================================================================
# Mule Runtime Files
# ====================================================================

# Mule application archives
*.jar
*.war
*.ear
*.zip
!wrapper.jar

# Mule deployment directories
.mule/
.munit/
mule-project.xml
repository/

# Mule logs
*.log
*.log.*
logs/
velocity.log

# ====================================================================
# IDE and Editor Files
# ====================================================================

# Eclipse
.project
.classpath
.settings/
.metadata/
*.launch
.loadpath
.externalToolBuilders/
.cproject
.buildpath
*.pydevproject
bin/**
tmp/**
tmp/**/*
*~.nib
local.properties

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code
.vscode/
*.code-workspace

# Anypoint Studio
.studio/

# ====================================================================
# Operating System Files
# ====================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ====================================================================
# Environment and Secrets
# ====================================================================

# Environment configuration files
.env
.env.local
.env.*.local
*.env.bak

# Credentials and secrets (IMPORTANT!)
*credentials*
*secrets*
*.key
*.pem
*.p12
*.jks
*.pfx

# ====================================================================
# Temporary and Cache Files
# ====================================================================

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup

# Cache directories
.cache/
__pycache__/
*.pyc

# ====================================================================
# Test and Coverage Reports
# ====================================================================

# MUnit test results
munit-reports/

# Code coverage
coverage/
*.coverage

# ====================================================================
# Deployment and Distribution
# ====================================================================

# Deployment archives (built by Maven)
# These are generated by the build process

# Keep important scripts
!01-build-and-deploy.sh

# ====================================================================
# Notes
# ====================================================================
# This .gitignore is configured for Mule 4 applications:
#
# ✅ TRACKED (committed to git):
#   - Source code (src/main/mule/, src/main/java/)
#   - Configuration files (src/main/resources/config/)
#   - API definitions (src/main/resources/api/)
#   - pom.xml and Maven configuration
#   - Build scripts (01-build-and-deploy.sh)
#   - Documentation files
#
# ❌ NOT TRACKED (git-ignored):
#   - Build artifacts (target/, *.jar, *.zip)
#   - IDE files (.idea/, .settings/, .classpath)
#   - Environment secrets (.env, credentials, *.key)
#   - Logs and temporary files (*.log, *.tmp)
#   - Runtime data (.mule/, repository/)
#
# To build: mvn clean package
# To deploy: ./01-build-and-deploy.sh
# ====================================================================
