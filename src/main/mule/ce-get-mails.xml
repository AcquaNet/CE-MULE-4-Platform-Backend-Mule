<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:file="http://www.mulesoft.org/schema/mule/file" xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:email="http://www.mulesoft.org/schema/mule/email"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd
http://www.mulesoft.org/schema/mule/file http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd">
	 
	<email:imap-config name="Email_IMAPS" doc:name="Email IMAP" doc:id="9580aae5-d750-4056-9560-7ad4609e1b59" >
		<email:imaps-connection host="${imap_inbound_host}" port="${imap_inbound_port}" user="${imap_inbound_user}" password="${imap_inbound_password}" >
			<tls:context enabledProtocols="TLSv1.2" >
				<tls:trust-store path="keystore/truststore.ts" password="${trustore.password}" type="jks" insecure="true" />
				<tls:key-store type="jks" path="keystore/keystore.jks" alias="${jks.alias}" keyPassword="${jks.keyPassword}" password="${jks.password}" />
			</tls:context>
		</email:imaps-connection>
	</email:imap-config>
	
	<file:config name="File_Config" doc:name="File Config" doc:id="3bba0c3a-eb21-4f41-97cf-815ee1edceea" >
		<file:connection workingDir="${email_folder_root}" />
	</file:config>
	
	<flow name="ce-get-mails-flow" doc:id="7bdcb8e9-d019-4c5d-b42e-131efae43f1f" >
		<email:listener-imap doc:name="On New Email - IMAP" doc:id="58e2dee5-8a7f-43a5-a233-69df34ff1fca" config-ref="Email_IMAPS">
			<scheduling-strategy>
			    <cron expression="${imap_inbound_cron}"/>
		    </scheduling-strategy>
			<email:imap-matcher />
		</email:listener-imap>
		<set-variable value='#[%dw 2.0&#10;output application/java&#10;---     &#10;{&#10;   "id": attributes.number,&#10;   "sentDate": attributes.sentDate,&#10;   "receivedDate": attributes.receivedDate,&#10;   "subject": attributes.subject,&#10;   "fromAddresses": attributes.fromAddresses[0],&#10;   "toAddresses": attributes.toAddresses,&#10;   "ccAddresses": attributes.ccAddresses,&#10;   "bccAddresses": attributes.bccAddresses,&#10;   "fromAddress": (((attributes.fromAddresses[0]) scan /&lt;([^&gt;]+)&gt;/)[0][1]) as String&#10;}]' doc:name="Save Email" doc:id="411e6f3b-3f19-47a6-ae11-f0d06d10f215" variableName="EmailReceived" mimeType="application/java" />
		<set-variable value='#[%dw 2.0&#10;output application/json&#10;---&#10;(entriesOf(payload.attachments default {}))&#10;  map (e) -&gt; {&#10;    name: (e.key as String),&#10;    mimeType: ((e.value.^mediaType as String) splitBy ";")[0]&#10;  }]' doc:name="Get Attachment MimeTypes" doc:id="d416b6bd-8450-4d7d-a538-7f37a1f0f7fa" variableName="mimeTypes" />
		<logger level="INFO" doc:name="Logger" doc:id="c900bd28-468c-432f-bc1b-223dcda195d4" message='#["Email received: " ++ (vars.EmailReceived.id as String) ++ " Date: " ++ vars.EmailReceived.sentDate as String ++ " Subject: " ++ vars.EmailReceived.subject]' />
		<file:list doc:name="Check Rule" doc:id="0b8bd8f4-2bca-4d65-a093-212ceec0c5f1" config-ref="File_Config" directoryPath="#[p('email_rules_folders') ++ p('entidad.id')]" target="rulesListFile">
			<file:matcher filenamePattern='#[vars.EmailReceived.fromAddress ++ ".json"]' />
		</file:list>
		<choice doc:name="Choice" doc:id="1629c827-f5dd-4e86-b627-2c715b4f37c7" >
			<when expression="#[sizeOf(vars.rulesListFile)&gt;0]">
				<file:read doc:name="Read Rules" doc:id="bc1b0cdb-93aa-429b-aa48-f957b981b63e" config-ref="File_Config" path="#[p('email_rules_folders') ++ p('entidad.id') ++ &quot;/&quot; ++ vars.EmailReceived.fromAddress ++ &quot;.json&quot;]" outputMimeType="application/json" outputEncoding="ISO-8859-1" target="rules"/>
				<set-variable value="#[read(vars.rules, 'application/json')]" doc:name="Set Rule Config" doc:id="be638ec7-6c44-4c51-9e52-505d953c7336" variableName="rulesConfig"/>
				<file:write doc:name="Write Email Metadata" doc:id="34a65b80-e623-4e18-9aa1-5b26d7ed22ac" config-ref="File_Config" path="#[p('entidad.id') ++ &quot;/&quot; ++ p('email_folder_to_save_emails') ++ vars.rules.id ++ &quot;_&quot; ++ vars.rules.email ++ &quot;.json&quot;]">
			<file:content><![CDATA[#[%dw 2.0
output application/json
---
vars.EmailReceived ++ {
	"Attachments": vars.mimeTypes
}]]]></file:content>
		</file:write>
				<flow-ref doc:name="Process Attachments" doc:id="d50c5229-544f-4fc3-af84-23b40da9cd15" name="ce-get-mails-process-attachments-flow" />
				<logger level="INFO" doc:name="Logger" doc:id="f9868a65-1a21-4a2d-a85d-6f0fccaec1fb" message='#["Email processed: " ++ vars.EmailReceived.id as String]' />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="5b6bdb76-2004-4dde-bd20-455f17f85abc" message="There is not rule for this email source"/>
			</otherwise>
		</choice>
	</flow>
	<flow name="ce-get-mails-process-attachments-flow" doc:id="c4d6e130-1e61-4d26-a91a-88b9dd272053" >
		<foreach doc:name="For Each Attachments" doc:id="11d2cf8f-65e3-4e47-b179-d7f95fdffe7b" collection='#[%dw 2.0&#10;output application/java&#10;var allowed = (p("email_extension_to_process") default "")&#10;              splitBy ","&#10;              map ((x) -&gt; lower(trim(x)) replace "*." with "")&#10;---        &#10;entriesOf(payload.attachments)&#10;filter (&#10;    (item, index) -&gt; !isEmpty(&#10;        allowed filter ((ext) -&gt; lower(trim(item.key)) endsWith ("." ++ ext))&#10;    )&#10;)]'>
			<logger level="INFO" doc:name="Logger" doc:id="113183ad-b123-454b-82cc-e8d9e4c6e24e" message='#["Attachme received: " ++ payload.key]' />
			<set-variable value="#[payload.key]" doc:name="Set Attachment File Name" doc:id="8a76f4e3-aa78-4b80-bcff-5f538d0c27bc" variableName="fileName" />
			<set-payload value="#[payload.value]" mimeType="application/octet-stream" doc:name="Set Attachment Value" />
			<file:write doc:name="Write Attachment To File" doc:id="d3713c4e-4abd-4159-9995-49f0997add6b" config-ref="File_Config" path="#[p('entidad.id') ++ &quot;${email_folder_to_save_attachments}&quot; ++ vars.fileName]">
			</file:write>
			<logger level="INFO" doc:name="Logger" doc:id="f4cd1491-8ebc-4500-b500-60f30cde0ed1" message="File Saved ${email_folder_root}/${email_folder_to_save_attachments} #[vars.fileName]" />
		</foreach>
	</flow>
</mule>
