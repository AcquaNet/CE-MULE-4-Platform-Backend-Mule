<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:jms="http://www.mulesoft.org/schema/mule/jms" xmlns:file="http://www.mulesoft.org/schema/mule/file"
	xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:email="http://www.mulesoft.org/schema/mule/email" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd
http://www.mulesoft.org/schema/mule/file http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd
http://www.mulesoft.org/schema/mule/jms http://www.mulesoft.org/schema/mule/jms/current/mule-jms.xsd">
	 
	<email:imap-config name="Email_IMAPS" doc:name="Email IMAP" doc:id="9580aae5-d750-4056-9560-7ad4609e1b59" >
		<email:imaps-connection host="${imap_inbound_host}" port="${imap_inbound_port}" user="${imap_inbound_user}" password="${imap_inbound_password}" connectionTimeout="10" readTimeout="10" writeTimeout="10">
			<tls:context enabledProtocols="TLSv1.2" >
				<tls:trust-store path="keystore/truststore.ts" password="${trustore.password}" type="jks" insecure="true" />
				<tls:key-store type="jks" path="keystore/keystore.jks" alias="${jks.alias}" keyPassword="${jks.keyPassword}" password="${jks.password}" />
			</tls:context>
		</email:imaps-connection>
	</email:imap-config>
	
	<file:config name="File_Config" doc:name="File Config" doc:id="3bba0c3a-eb21-4f41-97cf-815ee1edceea" >
		<file:connection workingDir="${email_folder_root}" />
	</file:config>
	
	<email:smtp-config name="Email_SMTP" doc:name="Email SMTP" from="${main_smtp_email_from}">
	  <email:smtp-connection
	      host="${main_smtp_host}"
	      port="${main_smtp_port}"
	      user="${main_smtp_user}"
	      password="${main_smtp_pass}">
	
	    <email:properties>
	      <!-- Auth + STARTTLS (correcto para 587) -->
	      <email:property key="mail.smtp.auth" value="true"/>
	      <email:property key="mail.smtp.starttls.enable" value="true"/>
	      <email:property key="mail.smtp.starttls.required" value="true"/>
	
	      <!-- Java 17: OK con TLSv1.2/1.3, pero esto fuerza si querés -->
	      <email:property key="mail.smtp.ssl.protocols" value="TLSv1.2 TLSv1.3"/>
	
	      <!-- Timeouts (evita cuelgues / retries eternos) -->
	      <email:property key="mail.smtp.connectiontimeout" value="10000"/>
	      <email:property key="mail.smtp.timeout" value="10000"/>
	      <email:property key="mail.smtp.writetimeout" value="10000"/>
	
	      <!-- Logging útil si querés ver el handshake en detalle -->
	      <!-- <email:property key="mail.debug" value="false"/> -->
	    </email:properties>
	
	  </email:smtp-connection>
	</email:smtp-config>
 
	 
	
	<flow name="ce-get-mails-flow" doc:id="7bdcb8e9-d019-4c5d-b42e-131efae43f1f" >
		<email:listener-imap doc:name="On New Email - IMAP" doc:id="58e2dee5-8a7f-43a5-a233-69df34ff1fca" config-ref="Email_IMAPS">
			<scheduling-strategy>
			    <cron expression="${imap_inbound_cron}"/>
		    </scheduling-strategy>
			<email:imap-matcher />
		</email:listener-imap>
		<set-variable value='#[%dw 2.0&#10;output application/java&#10;---     &#10;{&#10;   "id": attributes.number,&#10;   "sentDate": attributes.sentDate,&#10;   "receivedDate": attributes.receivedDate,&#10;   "subject": attributes.subject,&#10;   "fromAddresses": attributes.fromAddresses[0],&#10;   "toAddresses": attributes.toAddresses,&#10;   "ccAddresses": attributes.ccAddresses,&#10;   "bccAddresses": attributes.bccAddresses,&#10;   "fromAddress": (((attributes.fromAddresses[0]) scan /&lt;([^&gt;]+)&gt;/)[0][1]) as String&#10;}]' doc:name="Save Email" doc:id="411e6f3b-3f19-47a6-ae11-f0d06d10f215" variableName="EmailReceived" mimeType="application/java" />
		<set-variable value='#[%dw 2.0&#10;output application/java&#10;---&#10;((entriesOf(payload.attachments default {}))&#10;  map (e) -&gt; {&#10;    name: (e.key as String),&#10;    mimeType: ((e.value.^mediaType as String) splitBy ";")[0]&#10; }) reduce ((item, acc = {}) -&gt;&#10;    acc ++ {&#10;      (item.name as String): {&#10;        mimeType: (item.mimeType as String)&#10;      }&#10;    }&#10;  )]' doc:name="Get Attachment MimeTypes" doc:id="d416b6bd-8450-4d7d-a538-7f37a1f0f7fa" variableName="AttachmentList" />
		<logger level="INFO" doc:name="Logger" doc:id="c900bd28-468c-432f-bc1b-223dcda195d4" message='#["Email received: " ++ (vars.EmailReceived.id as String) ++ " Date: " ++ vars.EmailReceived.sentDate as String ++ " Subject: " ++ vars.EmailReceived.subject]' />
		<file:list doc:name="Check Rule" doc:id="0b8bd8f4-2bca-4d65-a093-212ceec0c5f1" config-ref="File_Config" directoryPath="#[p('email_folder_root') ++ p('entidad.id') ++ p('email_rules_folders')]" target="rulesListFile">
			<file:matcher filenamePattern='#[vars.EmailReceived.fromAddress ++ ".json"]' />
		</file:list>
		<choice doc:name="Choice" doc:id="1629c827-f5dd-4e86-b627-2c715b4f37c7" >
			<when expression="#[sizeOf(vars.rulesListFile)&gt;0]">
				<file:read doc:name="Read Rules" doc:id="bc1b0cdb-93aa-429b-aa48-f957b981b63e" config-ref="File_Config" path="#[p('email_folder_root') ++ p('entidad.id') ++ p('email_rules_folders') ++ &quot;/&quot; ++ vars.EmailReceived.fromAddress ++ &quot;.json&quot;]" outputMimeType="application/json" outputEncoding="ISO-8859-1" target="rulesConfig"/>
				<set-variable value="#[vars.rulesConfig]" doc:name="Set Rules Object" doc:id="b5d9cf37-56db-4b71-9942-a5b2f17f49f1" variableName="rulesConfigObj" />
				<flow-ref doc:name="Process Attachments" doc:id="d50c5229-544f-4fc3-af84-23b40da9cd15" name="ce-get-mails-process-attachments-flow"/>
				<file:write doc:name="Write Email Metadata" doc:id="34a65b80-e623-4e18-9aa1-5b26d7ed22ac" config-ref="File_Config" path="#[p('entidad.id') ++ &quot;/&quot; ++ p('email_folder_to_save_emails') ++ (vars.rulesConfigObj.id as String) ++ &quot;_&quot; ++ (vars.EmailReceived.id as String) ++ &quot;_&quot; ++ (vars.rulesConfigObj.email  as String) ++ &quot;.json&quot;]">
			<file:content><![CDATA[#[%dw 2.0
output application/json
---
vars.EmailReceived ++ {
	"Attachments": vars.AttachmentList
}]]]></file:content>
		</file:write>
				<logger level="INFO" doc:name="Logger" doc:id="f9868a65-1a21-4a2d-a85d-6f0fccaec1fb" message='#["Email processed: " ++ vars.EmailReceived.id as String ++ " With Correlation ID: " ++ correlationId as String]' />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="5b6bdb76-2004-4dde-bd20-455f17f85abc" message="There is not rule for this email source"/>
			</otherwise>
		</choice>
		<jms:publish doc:name="Publish - Process Email" doc:id="f0f660a2-5500-4a20-8307-0e07f5d0a3af" config-ref="JMS_Config" destination="${apachemq.email.recepecion.queue.name}" sendCorrelationId="ALWAYS">
			<jms:message correlationId="#[correlationId]">
				<jms:body><![CDATA[#[%dw 2.0
output application/json
---
vars.EmailReceived ++ {
	"Attachments": vars.AttachmentList
} ++ {
	"templates": vars.rulesConfig.templates
}]]]></jms:body>
			</jms:message>
		</jms:publish>
	</flow>
	<flow name="ce-get-mails-process-attachments-flow" doc:id="c4d6e130-1e61-4d26-a91a-88b9dd272053" >
		<foreach doc:name="For Each Attachments" doc:id="11d2cf8f-65e3-4e47-b179-d7f95fdffe7b" collection='#[%dw 2.0&#10;output application/java&#10;var allowed = (p("email_extension_to_process") default "")&#10;              splitBy ","&#10;              map ((x) -&gt; lower(trim(x)) replace "*." with "")&#10;---        &#10;entriesOf(payload.attachments)&#10;filter (&#10;    (item, index) -&gt; !isEmpty(&#10;        allowed filter ((ext) -&gt; lower(trim(item.key)) endsWith ("." ++ ext))&#10;    )&#10;)]'>
			<logger level="INFO" doc:name="Logger" doc:id="113183ad-b123-454b-82cc-e8d9e4c6e24e" message='#["Attachme received: " ++ payload.key]' />
			<set-variable value="#[%dw 2.0&#10;output application/java&#10;var fileName = payload.key as String&#10;var cfg = vars.rulesConfigObj&#10;var rules = vars.rulesConfigObj.rules&#10;var ts = (vars.EmailReceived.receivedDate as DateTime) as String {format: &quot;yyyy-MM-dd-HH-mm-ss&quot;}&#10;var matched = (rules filter (r) -&gt; (fileName matches (r.fileRule as String)))[0] default null&#10;fun suffixMetodo(m) = if (isEmpty((m default &quot;&quot;) as String)) &quot;&quot; else &quot;_&quot; ++ (m as String)&#10;var ext =&#10;  if ((fileName default &quot;&quot;) contains &quot;.&quot;)&#10;    &quot;.&quot; ++ lower(((fileName splitBy &quot;.&quot;)[-1]) as String)&#10;  else&#10;    &quot;&quot;&#10;var seqNum = ((vars.counter default 1) as Number)&#10;var seq = (seqNum as String {format: &quot;0000&quot;})&#10;---&#10;if (matched == null)&#10; {&#10;  originalName: fileName,&#10;  normalizedName:&quot;&quot;,&#10;  ruleId: 0,&#10;  fileNamePath: ''&#10;    }&#10;else&#10;  {&#10;  	originalName: fileName,&#10;    normalizedName:&#10;      (cfg.id as String)&#10;      ++ &quot;_&quot; ++ (vars.EmailReceived.id as String) &#10;      ++ &quot;_&quot; ++ seq&#10;      ++ &quot;_&quot; ++ (matched.source as String)&#10;      ++ &quot;_&quot; ++ (matched.destination as String)&#10;      ++ suffixMetodo(matched.metodo)&#10;      ++ &quot;_&quot; ++ ts&#10;      ++ ext,&#10;    ruleId: matched.id,&#10;    fileNamePath: p('entidad.id') ++ &quot;/&quot; ++ p('email_folder_to_save_attachments') ++ (cfg.id as String)&#10;      ++ &quot;_&quot; ++ (vars.EmailReceived.id as String) &#10;      ++ &quot;_&quot; ++ seq&#10;      ++ &quot;_&quot; ++ (matched.source as String)&#10;      ++ &quot;_&quot; ++ (matched.destination as String)&#10;      ++ suffixMetodo(matched.metodo)&#10;      ++ &quot;_&quot; ++ ts&#10;      ++ ext&#10;   &#10;  }]" doc:name="Set Attachment File Name" doc:id="8a76f4e3-aa78-4b80-bcff-5f538d0c27bc" variableName="fileName" />
			<choice doc:name="Choice" doc:id="67ef6517-d8d8-4234-b611-5f0b55564064" >
				<when expression="#[!isEmpty(vars.fileName.normalizedName)]">
					<set-payload value="#[payload.value]" mimeType="application/octet-stream" doc:name="Set Attachment Value" />
					<file:write doc:name="Write Attachment To File" doc:id="d3713c4e-4abd-4159-9995-49f0997add6b" config-ref="File_Config" path="#[vars.fileName.fileNamePath]">
			</file:write>
					<logger level="INFO" doc:name="Logger" doc:id="f4cd1491-8ebc-4500-b500-60f30cde0ed1" message="#[&quot;File Saved: &quot; ++ p('entidad.id') ++ &quot;/&quot; ++ p('email_folder_to_save_attachments') ++ vars.fileName.normalizedName]" />
				</when>
				<otherwise >
					<logger level="INFO" doc:name="Logger" doc:id="094e4d56-f857-4b3e-ac92-1453595e254f" message="#[&quot;File without rules: &quot; ++ p('entidad.id') ++ &quot;/&quot; ++ p('email_folder_to_save_attachments') ++ vars.fileName.originalName]" />
				</otherwise>
			</choice>
			<set-variable value='#[%dw 2.0&#10;output application/java&#10;var att = vars.AttachmentList default {}&#10;var fn  = vars.fileName default {}&#10;var orig = (fn.originalName default "") as String&#10;---&#10;att mapObject ((v, k) -&gt;&#10;  if ((k as String) == orig)&#10;    {(k as String): (v ++ { normalizedName: fn.normalizedName, ruleId: fn.ruleId, fileNamePath: fn.fileNamePath })}&#10;  else&#10;    {(k as String): v}&#10;)]' doc:name="Update AttachmentList" doc:id="bdc0c3b5-ae6c-43f7-81a2-159ce58012e6" variableName="AttachmentList"/>
		</foreach>
		<remove-variable doc:name="Remove fileName var" doc:id="c773fd1b-8a9a-4a97-834d-e01b5752695b" variableName="fileName"/>
	</flow>
	<flow name="ce-get-mailsFlow" doc:id="be1030ff-a4b5-4317-a2f1-01c3f0d9ba06" >
		<jms:listener doc:name="On New Email To Process" doc:id="7f2fbae7-947f-4f4f-ac25-1f4b3b61d5e3" config-ref="JMS_Config" destination="${apachemq.email.recepecion.queue.name}" ackMode="AUTO" numberOfConsumers="1">
			<jms:consumer-type >
				<jms:queue-consumer />
			</jms:consumer-type>
			<jms:response sendCorrelationId="ALWAYS" />
		</jms:listener>
		<logger level="INFO" doc:name="Logger" doc:id="630a38ae-5a22-4ed9-aeb2-a64e155e6ea1" message='#["Email to Process: " ++ (payload.id as String) ++ " Subject: " ++ (payload.subject as String)]'/>
		<choice doc:name="Choice" doc:id="32c57964-e3cf-465f-9e68-3fd9737d587d" >
			<when expression="#[(p('email_notificar_recepcion') as Boolean)]" >
				<logger level="INFO" doc:name="Logger" doc:id="6e8d7101-9ea2-4206-a191-242253c788f1" message="#[payload]" />
				<file:list doc:name="Check Email Template" doc:id="43b427ab-b72b-49c5-a4c4-e99f87b13e16" config-ref="File_Config" directoryPath="#[p('email_folder_root') ++ p('entidad.id') ++ p('email_template_folders')]" target="templateListFile">
					<file:matcher filenamePattern="#[payload.templates.'email-received']" />
				</file:list>
				<choice doc:name="Choice" doc:id="942d8d89-e38c-47fc-85fb-0b08af7f7378" >
					<when expression="#[sizeOf(vars.templateListFile)&gt;0]">
						<file:read doc:name="Read Template" doc:id="37810288-605b-4680-b4da-329d839de8b5" config-ref="File_Config" path="#[p('email_folder_root') ++ p('entidad.id') ++ p('email_template_folders') ++ payload.templates.'email-received']" outputMimeType="application/json" outputEncoding="ISO-8859-1" target="templateHTML" />
						<parse-template doc:name="Parse Template" doc:id="6f882317-2c33-4f45-ba4a-62db6e54dd5d" target="replyHtml" outputMimeType="text/html" outputEncoding="UTF-8" location="/private/tmp/process-mails/ATINA/config/email-templates/reply-mail-received.html">
				</parse-template>
						<email:send doc:name="Send" doc:id="c7c1ba59-a33e-4325-a02a-70065b7f452b" config-ref="Email_SMTP" fromAddress="${main_smtp_user}">
					<email:to-addresses>
						<email:to-address value="#[payload.fromAddress]" />
					</email:to-addresses>
					<email:body encoding="UTF-8" contentType="text/html">
						<email:content><![CDATA[#[vars.replyHtml]]]></email:content>
					</email:body>
				</email:send>
						<logger level="INFO" doc:name="Logger" doc:id="d09dd028-35ce-4690-9f2e-49797d18cbb0" message='#["Email Enviado: " ++ (payload.id as String)]' />
					</when>
					<otherwise >
						<raise-error doc:name="Raise error" doc:id="bcfe35b8-cd24-441d-b7e3-10985ed65a73" type="MAIL:TEMPLATE_MISSING" description="#[p('email_folder_root') ++ p('entidad.id') ++ p('email_template_folders') ++ payload.templates.email-received ++ &quot;.json Missing&quot;] "/>
					</otherwise>
				</choice>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Logger" doc:id="456cc6ff-7910-4c45-9c0e-a56f68b5f368" message="Property email_notificar_recepcion is false"/>
			</otherwise>
		</choice>
	</flow>
</mule>
